# Chapter: Rules (lmcode) - C function metrics
# Shows: @function_definition rules, Node arithmetic (end_row - start_row), child-walk parameter counting
# Run: lmscript rules/lmcode/c-function-metrics.lms   (then: lmok check --lang c build/rules-lmcode/c-function-metrics.dslb tests/fixtures/c-logic-violations.c)
# check: c tests/fixtures/c-logic-violations.c
# Needs: nothing (offline); reads tests/fixtures/c-logic-violations.c
# exit: 0
# expect:
#|[{"row":0,"col":0,"end_row":65,"end_col":1,"rule":"LBC101","severity":"major","message":"function too long (65 rows)"},{"row":67,"col":0,"end_row":69,"end_col":1,"rule":"LBC102","severity":"minor","message":"too many parameters (8)"}]
#|2 findings in tests/fixtures/c-logic-violations.c
p = _lmcode_ cli="lmok";

# Tier-1 rules that need lmcode LOGIC (arithmetic, counting) — not expressible
# as pack selector+regex. To use against your own file, copy the rule fn and
# pass the input to check (see rules/README.md).

@function_definition
fn function_too_long(n: Node) -> void implements Rule {
  let rows = n.end_row() - n.start_row();
  if (rows > 60) {
    ts.report(n, "function too long (" + str(rows) + " rows)", "LBC101", "major");
  }
}

fn count_params(n: Node) -> int {
  # function_definition -> function_declarator -> parameter_list -> parameter_declaration*
  let count = 0;
  for (i in range(0, n.child_count())) {
    let d = n.child(i);
    if (d.kind() == "function_declarator") {
      for (j in range(0, d.child_count())) {
        let pl = d.child(j);
        if (pl.kind() == "parameter_list") {
          for (k in range(0, pl.child_count())) {
            if (pl.child(k).kind() == "parameter_declaration") { count = count + 1; }
          }
        }
      }
    }
  }
  return count;
}

@function_definition
fn too_many_parameters(n: Node) -> void implements Rule {
  let count = count_params(n);
  if (count > 7) {
    ts.report(n, "too many parameters (" + str(count) + ")", "LBC102", "minor");
  }
}

end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmcode host failed");
