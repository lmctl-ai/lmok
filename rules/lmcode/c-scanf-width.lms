# Chapter: Rules (lmcode) - scanf without field width (tier 2: query predicates)
# Shows: #match? predicate selecting calls, two-capture pairing (fn + format), width heuristic
# Run: lmscript rules/lmcode/c-scanf-width.lms   (then: lmok check --lang c build/rules-lmcode/c-scanf-width.dslb tests/fixtures/c-scanf-violations.c)
# check: c tests/fixtures/c-scanf-violations.c
# Needs: nothing (offline); reads tests/fixtures/c-scanf-violations.c
# exit: 0
# expect:
#|[{"row":5,"col":2,"end_row":5,"end_col":7,"rule":"LBC106","severity":"major","message":"scanf-family call without field width in \"%s\""}]
#|1 findings in tests/fixtures/c-scanf-violations.c
p = _lmcode_ cli="lmok";

# Keep the original two-capture predicate query inside the current call.
# Filter nested-call captures: each call is dispatched separately by the host.
@call_expression
fn check_scanf(call: Node) -> void implements Rule {
  let captures = ts.query_c(call, "((call_expression function: (identifier) @fn (argument_list (string_literal (string_content) @fmt))) (#match? @fn \"^(f)?scanf$\"))");
  for (i in range(0, captures.len() / 2)) {
    let fn_node = captures.at(2 * i);
    let fmt_node = captures.at(2 * i + 1);
    if (call.child_count() > 0 && fn_node.start_row() == call.child(0).start_row() && fn_node.start_col() == call.child(0).start_col()) {
      let fmt = fmt_node.text();
      if (str_contains(fmt, "%s") || str_contains(fmt, "%[")) {
        ts.report(fn_node, "scanf-family call without field width in \"" + fmt + "\"", "LBC106", "major");
      }
    }
  }
}

end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmcode host failed");
