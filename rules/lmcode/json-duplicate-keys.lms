# Chapter: Rules (lmcode) - duplicate keys in JSON objects
# Shows: @object rule, per-object StrMap bookkeeping, pair key extraction
# Run: lmscript rules/lmcode/json-duplicate-keys.lms   (then: lmok check --lang json build/rules-lmcode/json-duplicate-keys.dslb tests/fixtures/json-dupkeys-violations.json)
# check: json tests/fixtures/json-dupkeys-violations.json
# Needs: nothing (offline); reads tests/fixtures/json-dupkeys-violations.json
# exit: 0
# expect:
#|[{"row":3,"col":2,"end_row":3,"end_col":8,"rule":"LBJ101","severity":"major","message":"duplicate key \"a\""},{"row":6,"col":4,"end_row":6,"end_col":10,"rule":"LBJ101","severity":"major","message":"duplicate key \"x\""}]
#|2 findings in tests/fixtures/json-dupkeys-violations.json
p = _lmcode_ cli="lmok";

# Duplicate keys are sibling relationships — a query pattern cannot express
# "same text twice among siblings", so this is lmcode logic over a StrMap.
# The map is fn-local: each object gets a fresh scope (nested objects are
# checked independently).

@object
fn no_duplicate_keys(n: Node) -> void implements Rule {
  let seen = str_map();
  for (i in range(0, n.child_count())) {
    let pair = n.child(i);
    if (pair.kind() == "pair") {
      let key = pair.child(0).text();
      if (seen.has(key)) {
        ts.report(pair, "duplicate key " + key, "LBJ101", "major");
      } else {
        seen.set(key, "1");
      }
    }
  }
}

end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmcode host failed");
