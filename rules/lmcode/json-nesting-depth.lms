# Chapter: Rules (lmcode) - deep value nesting in JSON (tier 2: Node.parent)
# Shows: Node.has_parent/parent chain walk, container-kind predicate
# Run: lmscript rules/lmcode/json-nesting-depth.lms   (then: lmok check --lang json build/rules-lmcode/json-nesting-depth.dslb tests/fixtures/json-nesting-violations.json)
# check: json tests/fixtures/json-nesting-violations.json
# Needs: nothing (offline); reads tests/fixtures/json-nesting-violations.json
# exit: 0
# expect:
#|[{"row":0,"col":36,"end_row":0,"end_col":44,"rule":"LBJ103","severity":"major","message":"value nested 7 levels deep (max 6)"}]
#|1 findings in tests/fixtures/json-nesting-violations.json
p = _lmcode_ cli="lmok";

# Depth = number of object/array containers on the ancestor chain (self
# included); pairs and scalars don't count. Report the deepest container only:
# with a chain of N nested containers, only the one at depth > 6 fires.

fn is_container(n: Node) -> int {
  let hit = 0;
  let k = n.kind();
  if (k == "object" || k == "array") { hit = 1; }
  return hit;
}

@object
fn no_deep_nesting(n: Node) -> void implements Rule {
  if (is_container(n) == 1) {
    let depth = 1;
    let cur = n;
    while (cur.has_parent()) {
      cur = cur.parent();
      if (is_container(cur) == 1) { depth = depth + 1; }
    }
    if (depth > 6) {
      ts.report(n, "value nested " + str(depth) + " levels deep (max 6)", "LBJ103", "major");
    }
  }
}

@array
fn no_deep_nesting_array(n: Node) -> void implements Rule { no_deep_nesting(n); }

end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmcode host failed");
