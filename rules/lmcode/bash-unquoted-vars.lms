# Chapter: Rules (lmcode) - unquoted variables in bash (tier 2: Node.parent)
# Shows: Node.has_parent/parent chain walk, @simple_expansion/@expansion rules
# Run: lmscript rules/lmcode/bash-unquoted-vars.lms   (then: lmok check --lang bash build/rules-lmcode/bash-unquoted-vars.dslb tests/fixtures/bash-logic-violations.sh)
# check: bash tests/fixtures/bash-logic-violations.sh
# Needs: nothing (offline); reads tests/fixtures/bash-logic-violations.sh
# exit: 0
# expect:
#|[{"row":1,"col":5,"end_row":1,"end_col":7,"rule":"LBS101","severity":"major","message":"unquoted variable $1"},{"row":2,"col":5,"end_row":2,"end_col":10,"rule":"LBS101","severity":"major","message":"unquoted variable $name"},{"row":4,"col":5,"end_row":4,"end_col":12,"rule":"LBS101","severity":"major","message":"unquoted variable ${name}"}]
#|3 findings in tests/fixtures/bash-logic-violations.sh
p = _lmcode_ cli="lmok";

# "Unquoted" = no `string` ancestor: needs UPWARD navigation (extension E2) —
# a pack regex cannot see context. The Rule SAM is single-kind, so the two
# expansion node kinds get one annotated fn each over a shared helper.

fn is_quoted(n: Node) -> int {
  let hit = 0;
  let cur = n;
  while (cur.has_parent()) {
    cur = cur.parent();
    if (cur.kind() == "string") { hit = 1; }
  }
  return hit;
}

@simple_expansion
fn unquoted_simple_expansion(n: Node) -> void implements Rule {
  if (is_quoted(n) == 0) {
    ts.report(n, "unquoted variable " + n.text(), "LBS101", "major");
  }
}

@expansion
fn unquoted_expansion(n: Node) -> void implements Rule {
  if (is_quoted(n) == 0) {
    ts.report(n, "unquoted variable " + n.text(), "LBS101", "major");
  }
}

end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmcode host failed");
