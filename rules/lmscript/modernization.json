{
  "lang": "lmscript",
  "rules": [
    {
      "id": "LMS001",
      "on": "ternary_expression",
      "message": "house policy: prefer if/else blocks to ternary expressions (the language supports ternary syntax)",
      "severity": "minor"
    },
    {
      "id": "LMS002",
      "message": "parallel requires a literal array; use parallel_map for generated inputs",
      "severity": "minor",
      "capture": "args",
      "guard": "computed_parallel",
      "guarded_query": "((call_expression (identifier) @callee (argument_list) @args) (#eq? @callee \"parallel\"))"
    },
    {
      "id": "LMS003",
      "query": "((for_statement (identifier) (identifier) @args) (#eq? @args \"ARGV\"))",
      "capture": "args",
      "message": "hand-parsed ARGV loop; use args_parse(ARGV, schema)",
      "severity": "minor"
    },
    {
      "id": "LMS004",
      "query": "((for_statement (identifier) (call_expression (identifier) @range (argument_list (number) (call_expression (identifier) @len (argument_list (identifier) @args))))) (#eq? @range \"range\") (#eq? @len \"len\") (#eq? @args \"ARGV\"))",
      "capture": "args",
      "message": "indexed ARGV loop; use args_parse(ARGV, schema)",
      "severity": "minor"
    },
    {
      "id": "LMS005",
      "query": "((call_expression (identifier) @outer (argument_list . (call_expression (identifier) @inner))) (#eq? @outer \"str\") (#eq? @inner \"get\"))",
      "capture": "outer",
      "message": "str(get(...)) loses typed access; use getstr/getnum/getbool/getlist and require",
      "severity": "minor"
    },
    {
      "id": "LMS006",
      "capture": "name",
      "message": "bare Provider/Model globals were removed; read the explicit PROPS.<provider>.Provider/ModelN path",
      "severity": "minor",
      "guard": "unbound_identifier",
      "guarded_query": "((let_statement . (identifier) . (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((assignment_expression . (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((binary_expression (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((return_statement (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((if_statement (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((member_expression . (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((for_statement . (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((for_statement (identifier) (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((expression_statement . (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\"))"
    },
    {
      "id": "LMS007",
      "message": "bare Provider/Model argument; use the explicit PROPS property",
      "severity": "minor",
      "capture": "name",
      "guard": "unbound_identifier",
      "guarded_query": "((argument_list (identifier) @name) (#match? @name \"^(Provider[1-3]|Model[1-3])$\")) ((argument_list (list_literal (identifier) @name)) (#match? @name \"^(Provider[1-3]|Model[1-3])$\"))"
    },
    {
      "id": "LMS008",
      "query": "(import_statement (plain_string) @path)",
      "capture": "path",
      "text_matches": "^\"native:",
      "message": "native: imports were removed; import a local module or use the registered host API",
      "severity": "minor"
    },
    {
      "id": "LMS009",
      "query": "(import_statement (plain_string) @path)",
      "capture": "path",
      "text_matches": "^\"@[^/\"]+/[^\"]+\"$",
      "message": "@owner module-store imports are retired; use a caller-relative module path",
      "severity": "minor"
    },
    {
      "id": "LMS010",
      "capture": "callee",
      "text_matches": "^(savedsl|dsl_cli)$",
      "message": "savedsl/dsl_cli bytecode plumbing is retired; use an executing lmcode block",
      "severity": "minor",
      "guard": "unbound_identifier",
      "guarded_query": "(call_expression (identifier) @callee)"
    },
    {
      "id": "LMS011",
      "query": "(marker_expression (block_marker) @marker)",
      "capture": "marker",
      "text_matches": "^_dsl_$",
      "message": "_dsl_ is a retired alias; use _lmcode_ (update the matching end marker too)",
      "severity": "minor"
    },
    {
      "id": "LMS012",
      "capture": "flag",
      "text_matches": "^\"--dsl\"$",
      "message": "--dsl is retired; use --lmcode",
      "fix": "\"--lmcode\"",
      "severity": "minor",
      "guard": "host_option",
      "guarded_query": "(system_call (list_literal (plain_string) @flag))"
    },
    {
      "id": "LMS013",
      "capture": "flag",
      "text_matches": "^\"--dsl-schema\"$",
      "message": "--dsl-schema is retired; use --lmcode-schema",
      "fix": "\"--lmcode-schema\"",
      "severity": "minor",
      "guard": "host_option",
      "guarded_query": "(system_call (list_literal (plain_string) @flag))"
    },
    {
      "id": "LMS014",
      "capture": "flag",
      "text_matches": "^\"--dsl-signatures\"$",
      "message": "--dsl-signatures is retired; use --lmcode-signatures",
      "fix": "\"--lmcode-signatures\"",
      "severity": "minor",
      "guard": "host_option",
      "guarded_query": "(system_call (list_literal (plain_string) @flag))"
    },
    {
      "id": "LMS015",
      "capture": "call",
      "message": "lmctl script invocation omits the required --check preflight",
      "severity": "minor",
      "guard": "unchecked_lmctl_script",
      "guarded_query": "(system_call) @call (command) @call"
    },
    {
      "id": "LMS016",
      "query": "((source_file . (if_statement (identifier) (block (expression_statement (assignment_expression (identifier) @assigned)))) . (expression_statement (call_expression (identifier) (argument_list (identifier) @used))) (#eq? @assigned @used)))",
      "capture": "used",
      "message": "value first assigned in a branch is not visible afterward; declare it before the conditional",
      "severity": "minor"
    }
  ]
}
