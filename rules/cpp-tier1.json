      "severity": "major",
      "tags": [
        "cpp",
        "reliability"
      ],
      "confidence": "high",
      "url": "https://cwe.mitre.org/data/definitions/390.html",
      "cwe": [
        "CWE-390"
      ]
    },
    {
      "id": "CPP004",
      "query": "[(translation_unit (using_declaration \"namespace\") @u) (translation_unit (preproc_ifdef (using_declaration \"namespace\") @u)) (translation_unit (preproc_if (using_declaration \"namespace\") @u))]",
      "message": "using namespace directive at file or header scope",
      "severity": "major",
      "tags": [
        "cpp",
        "maintainability"
      ],
      "confidence": "medium",
      "url": "https://github.com/lmctl-ai/lmok#rule-packs"
    },
    {
      "id": "CPP005",
      "query": "((call_expression function: (template_function name: (identifier) @cast)) @site (#match? @cast \"^(reinterpret_cast|const_cast)$\"))",
      "capture": "site",
      "message": "unsafe C++ cast '{text}'",
      "severity": "major",
      "tags": [
        "cpp",
        "safety"
      ],
      "confidence": "medium",
      "url": "https://cwe.mitre.org/data/definitions/704.html",
      "cwe": [
        "CWE-704"
      ]
    },
    {
      "id": "CPP006",
      "query": "[(if_statement condition: (condition_clause value: (assignment_expression operator: \"=\") @assign)) (while_statement condition: (condition_clause value: (assignment_expression operator: \"=\") @assign))]",
      "message": "assignment used directly inside condition",
      "severity": "major",
      "tags": [
        "cpp",
        "correctness"
      ],
      "confidence": "medium",
      "url": "https://cwe.mitre.org/data/definitions/481.html",
      "cwe": [
        "CWE-481"
      ]
    },
    {
