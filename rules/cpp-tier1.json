{
  "lang": "cpp",
  "rules": [
    {
      "id": "CPP001",
      "query": "((call_expression function: [(identifier) @fn (qualified_identifier name: (identifier) @fn)]) @site (#match? @fn \"^(gets|strcpy|strcat|sprintf|vsprintf)$\"))",
      "capture": "site",
      "message": "unsafe buffer call '{text}'",
      "severity": "critical",
      "tags": [
        "cpp",
        "security"
      ],
      "confidence": "high",
      "url": "https://cwe.mitre.org/data/definitions/120.html",
      "cwe": [
        "CWE-120"
      ]
    },
    {
      "id": "CPP002",
      "query": "((call_expression function: [(identifier) @fn (qualified_identifier name: (identifier) @fn)]) @site (#match? @fn \"^(system|popen|_popen|execl|execlp|execle|execv|execvp|execvpe)$\"))",
      "capture": "site",
      "message": "command exec call '{text}'",
      "severity": "critical",
      "tags": [
        "cpp",
        "security"
      ],
      "confidence": "medium",
      "url": "https://cwe.mitre.org/data/definitions/78.html",
