# Chapter: Rules - lint C code for unsafe calls and FIXMEs
# Shows: ts.parse_c/query_c (C grammar), @call_expression/@comment rules, ts.report with rule key + severity
# Run: lmscript examples/lint-c.lms      (then: build/lmok --lmcode build/lint-c.dslb)
# Needs: README setup; repo root, build/ present, lmok on PATH; offline after setup.
# Data: the C source is embedded below.
# exit: 0
# expect:
#|[{"row":5,"col":2,"end_row":5,"end_col":6,"rule":"LBC001","severity":"critical","message":"unsafe call 'gets'"},{"row":6,"col":2,"end_row":6,"end_col":8,"rule":"LBC001","severity":"critical","message":"unsafe call 'strcpy'"},{"row":7,"col":2,"end_row":7,"end_col":9,"rule":"LBC001","severity":"critical","message":"unsafe call 'sprintf'"},{"row":6,"col":24,"end_row":6,"end_col":54,"rule":"LBC002","severity":"minor","message":"unresolved FIXME comment"}]
#|4 findings
p = _lmcode_ cli="lmok" install="github:lmctl-ai/lmok@latest";

# SonarQube-style security rules over real C, with analyzer-style metadata:
# every finding carries a rule key and a severity (free-form strings — policy
# belongs to the script; the host validates nothing). The query selects
# candidates by structure, the rule body does the text check and reports.
# Annotations are compile-time metadata (the CST node kind each rule
# subscribes to).

@call_expression
fn no_unsafe_fn(n: Node) -> void implements Rule {
  # n is the called function's identifier node.
  let name = n.text();
  if (name == "gets" || name == "strcpy" || name == "sprintf") {
    ts.report(n, "unsafe call '" + name + "'", "LBC001", "critical");
  }
}

@comment
fn no_fixme(n: Node) -> void implements Rule {
  if (str_contains(n.text(), "FIXME")) {
    ts.report(n, "unresolved FIXME comment", "LBC002", "minor");
  }
}

let tree = ts.parse_c("#include <stdio.h>\n#include <string.h>\n\nvoid login(char *input) {\n  char buf[16];\n  gets(input);          /* never use */\n  strcpy(buf, input);   // FIXME: replace with strncpy\n  sprintf(buf, \"%s\", input);\n  printf(\"%s\", buf);\n}\n");

for (f in ts.query_c(tree.root(), "(call_expression function: (identifier) @fn)")) {
  no_unsafe_fn(f);
}
for (c in ts.query_c(tree.root(), "(comment) @c")) {
  no_fixme(c);
}

println(ts.report_json());
println(str(ts.report_count()) + " findings");

end _lmcode_
savedsl(p, "build/lint-c.dslb");
