# Chapter: Errors - detect malformed JSON
# Shows: ts.parse, Tree.has_error, ERROR nodes in the s-expression tree
# Run: lmscript examples/detect-error.lms      (then: build/lmok --lmcode build/detect-error.dslb)
# Needs: README setup; repo root, build/ present, lmok on PATH; offline after setup.
# Data: the malformed JSON text is embedded below.
# exit: 0
# expect:
#|malformed input detected
#|(document (object (pair key: (string (string_content)) value: (number)) (ERROR)))
p = _lmcode_ cli="lmok" install="github:lmctl-ai/lmok@latest";

let tree = ts.parse("{\"a\": 1,,}");

# tree-sitter always produces a tree; error nodes flag the broken part.
if (tree.has_error()) {
  println("malformed input detected");
} else {
  println("unexpected: input parsed cleanly");
}
println(tree.sexp());

end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmcode host failed");
