# Chapter: Files - parse a JSON file from disk
# Shows: file_read, ts.parse, Tree.sexp/has_error/node_count
# Run: lmscript examples/parse-file.lms
# Needs: README setup; repo root, build/ present, lmok on PATH; offline after setup.
# Data: reads examples/data/sample.json, run from the repository root.
# exit: 0
# expect:
#|(document (object (pair key: (string (string_content)) value: (string (string_content))) (pair key: (string (string_content)) value: (number)) (pair key: (string (string_content)) value: (true)) (pair key: (string (string_content)) value: (array (string (string_content)) (string (string_content))))))
#|has_error -> false
#|nodes -> 50
p = _lmcode_ cli="lmok" install="github:lmctl-ai/lmok@latest";

let text = file_read("examples/data/sample.json");
let tree = ts.parse(text);

println(tree.sexp());
println("has_error -> " + str(tree.has_error()));
println("nodes -> " + str(tree.node_count()));

end _lmcode_

r = run_lmcode(p);
assert(r.ok, "lmcode host failed");
