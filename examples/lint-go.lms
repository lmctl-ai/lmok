# Chapter: Go rule packs - gosec-flavored local checks
# Shows: use the Go parser-backed tier-1 pack through the lmok CLI
# Run: lmscript examples/lint-go.lms (repo root, build/lmok on PATH)
# exit: 0
# expect:
#|go-tier1: 7 findings

r = system(["lmok", "lint", "rules/go-tier1.json", "tests/fixtures/go-tier1-violations.go"]);
assert(r.code == 0);
println("go-tier1: " + str(count_matches(r.stdout, "\"rule\":")) + " findings");
