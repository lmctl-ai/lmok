// description: Run the TSX tier-1 pack over its JSX violation fixture.
//|tsx-tier1: 3 findings

let result = system(["lmok", "lint", "rules/tsx-tier1.json", "tests/fixtures/tsx-tier1-violations.tsx"]);
assert(result.code == 0);
println("tsx-tier1: " + str(count_matches(result.stdout, "\"rule\":")) + " findings");
