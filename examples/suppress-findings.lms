# Chapter: Rules - host inline suppression
# Shows: same-line selective lmok-disable in the host finding sink
# Run: lmscript examples/suppress-findings.lms      (then: build/lmok --lmcode build/suppress-findings.dslb)
# Needs: README setup; repo root, build/ present, lmok on PATH; offline after setup.
# Data: the C source is embedded below.
# exit: 0
# expect:
#|[{"row":7,"col":2,"end_row":7,"end_col":8,"rule":"LBC001","severity":"critical","message":"unsafe call 'strcpy'"},{"row":8,"col":2,"end_row":8,"end_col":9,"rule":"LBC001","severity":"critical","message":"unsafe call 'sprintf'"},{"row":8,"col":40,"end_row":8,"end_col":71,"rule":"LBC002","severity":"minor","message":"unresolved FIXME comment"}]
#|findings=3
p = _lmcode_ cli="lmok" install="github:lmctl-ai/lmok@latest";

# Rules report normally; the host sink applies source directives.

@call_expression
fn no_unsafe_fn(n: Node) -> void implements Rule {
  let name = n.text();
  if (name == "gets" || name == "strcpy" || name == "sprintf") {
    ts.report(n, "unsafe call '" + name + "'", "LBC001", "critical");
  }
}

@comment
fn no_fixme(n: Node) -> void implements Rule {
  if (str_contains(n.text(), "FIXME")) {
    ts.report(n, "unresolved FIXME comment", "LBC002", "minor");
  }
}

let tree = ts.parse_c("#include <stdio.h>\n#include <string.h>\n\nvoid login(char *input) {\n  char buf[16];\n  gets(input);                          // lmok-disable: LBC001\n\n  strcpy(buf, input);\n  sprintf(buf, \"%s\", input);            // FIXME: replace with snprintf\n  printf(\"%s\", buf);\n}\n");
let root = tree.root();

for (f in ts.query_c(root, "(call_expression function: (identifier) @fn)")) {
  no_unsafe_fn(f);
}
for (c in ts.query_c(root, "(comment) @c")) {
  no_fixme(c);
}

println(ts.report_json());
println("findings=" + str(ts.report_count()));

end _lmcode_
savedsl(p, "build/suppress-findings.dslb");
